# kindle-tools 通道配置模板
# 复制为 config.sh 并填入真实值; config.sh 已被 .gitignore 排除, 不入库
# 部署位置: 服务器分发目录 与 设备 /mnt/us/kindle-tools/config.sh

ENABLE_SSH=1        # ssh:    dropbear,   Mac: ssh root@<kindle>
ENABLE_TELNET=0     # telnet: minishelld, Mac: telnet <kindle>
ENABLE_POLL=1       # 命令轮询(管理通道, 服务器经 /cmd 驱动设备)

SSH_PORT=22
TELNET_PORT=23

# 轮询指向的服务器 (填运行 WinterBreak2 服务器的机器 IP)
SRV_IP=YOUR_MAC_IP
SRV_PORT=3000
