#!/bin/sh
# recovery.sh — kindle-tools 统一安装/恢复 (唯一安装器)
# 用法A: kterm 里 curl -sL http://YOUR_MAC_IP:3000/t | sh
# 用法B: 服务器 install 模式下按浏览器 "安装/修复 SSH" 按钮(WB2 触发, 子进程已剥离)
SRV=http://YOUR_MAC_IP:3000
T=/mnt/us/kindle-tools
S=/mnt/us/ssh

lipc-set-prop -i com.lab126.powerd preventScreenSaver 1 2>/dev/null
iptables -I INPUT 1 -i wlan0 -p tcp --dport 22 -j ACCEPT 2>/dev/null
iptables -I INPUT 1 -i wlan0 -p icmp -j ACCEPT 2>/dev/null
mkdir -p $T $S/bin $S/etc $T/ui

fetch() { curl -sfL --max-time 120 -o "$2.tmp" "$SRV/$1" && [ -s "$2.tmp" ] && mv -f "$2.tmp" "$2" || { echo "FAIL $1"; return 1; }; }

echo "[1/5] 下载组件..."
fetch config $T/config.sh
fetch boot $T/boot.sh
fetch dropbear $S/bin/dropbear
fetch dropbearkey $S/bin/dropbearkey
fetch rmsh $T/rmsh
fetch shd $T/minishelld
for st in ON_OFF ON_ON OFF_ON OFF_OFF; do
    fetch ui/rmsh_758_${st%%_*}_${st##*_}.png $T/ui/rmsh_758_${st%%_*}_${st##*_}.png
    fetch ui/rmsh_1072_${st%%_*}_${st##*_}.png $T/ui/rmsh_1072_${st%%_*}_${st##*_}.png
done
fetch sshentry "/mnt/us/documents/Remote Shell.sh"
chmod +x $T/boot.sh $S/bin/* $T/rmsh $T/minishelld "/mnt/us/documents/Remote Shell.sh"

echo "[2/5] 密钥..."
[ -f $S/etc/rsa2.key ] || $S/bin/dropbearkey -t rsa -f $S/etc/rsa2.key 2>&1 | tail -1
fetch pubkey $S/authorized_keys && chmod 600 $S/authorized_keys

echo "[3/5] 开机自启..."
mntroot rw 2>/dev/null
printf 'description "kindle-tools: firewall/keepawake/channels"\nstart on framework_ready\ntask\nexec /bin/sh /mnt/us/kindle-tools/boot.sh\n' > /etc/upstart/kindle-tools.conf
mntroot ro 2>/dev/null

echo "[4/5] photo-frame 相册..."
P=/mnt/us/photo-kit
mkdir -p $P/settings $P/photos
W=$(grep -ao "Virtual size is [0-9]*x" /var/log/Xorg.0.log 2>/dev/null | head -1 | grep -oE "[0-9]+")
[ -z "$W" ] && W=758
fetch pv $P/photoviewer
fetch photoentry "/mnt/us/documents/Photo.sh"
for i in 0 1 2 3 4 5; do for b in 0 1; do
    fetch "ktools/photo-frame/assets/settings-r${i}s${b}-${W}.png" $P/settings/r${i}s${b}.png
done; done
n=1
while [ $n -le 5 ]; do
    fetch "photo-test/$n.png?w=$W" $P/photos/frame_0$n.png || break
    n=$((n + 1))
done
[ -f $P/photo.conf ] || printf "# Photo 相册配置\nINTERVAL=600\nSLEEP=0\n" > $P/photo.conf
chmod +x $P/photoviewer "/mnt/us/documents/Photo.sh"

echo "[5/5] 拉起服务(已剥离进程树)..."
killall dropbear minishelld rmsh 2>/dev/null
sleep 1
sh $T/boot.sh
sleep 2
IP=$(ifconfig wlan0 2>/dev/null | grep -oE 'inet addr:[0-9.]+' | head -1 | cut -d: -f2)
echo "======================================"
echo " 完成! ssh root@${IP:-?} · 书库 Remote Shell"
echo "======================================"
